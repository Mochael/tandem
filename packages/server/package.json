{
	"name": "@tanishqkancharla/tandem-server",
	"version": "0.3.1",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"source": "./src/index.ts",
	"author": "Tanishq Kancharla <tanishqkancharla3@gmail.com>",
	"description": "Typed server database and durable storage APIs for Tandem",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tanishqkancharla/tandem.git",
		"directory": "packages/server"
	},
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./sql": {
			"types": "./dist/storage/TandemServerSqlStorage.d.ts",
			"import": "./dist/storage/TandemServerSqlStorage.js",
			"default": "./dist/storage/TandemServerSqlStorage.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
		"prepublishOnly": "pnpm run build",
		"type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"format": "oxfmt \"src/**/*.ts\" \"test/**/*.ts\"",
		"lint": "oxlint src --fix && tsc --noEmit",
		"test": "vitest run --config ../../vitest.config.js",
		"test:e2e": "vitest run --config ../../vitest.config.js test/e2e"
	},
	"dependencies": {
		"@tanishqkancharla/tandem-core": "workspace:*",
		"errore": "^0.14.1",
		"kysely": "^0.29.8",
		"tuple-database": "github:tanishqkancharla/tuple-database#ebe6b84edbc1371d0eb611cf5ca28d2f76be38db"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.14",
		"@types/node": "^26.6.4",
		"miniflare": "^4.20260730.0",
		"mysql2": "^3.24.6",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
