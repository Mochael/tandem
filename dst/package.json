{
	"name": "tandem-dst",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
		"format": "oxfmt \"*.ts\"",
		"lint": "oxlint .",
		"test": "vitest run --config ../vitest.config.js",
		"dst": "tsx cli.ts"
	},
	"dependencies": {
		"@tanishqkancharla/gatekeeper": "workspace:*",
		"@tanishqkancharla/tandem-core": "workspace:*",
		"@tanishqkancharla/tandem-server": "workspace:*",
		"errore": "^0.14.1",
		"tuple-database": "github:tanishqkancharla/tuple-database#ebe6b84edbc1371d0eb611cf5ca28d2f76be38db"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.14",
		"@types/node": "^26.6.4",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}
